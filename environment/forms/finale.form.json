{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["wave", "actors", "tiles", "checksum"],
  "properties": {
    "wave": { "type": "integer" },
    "actors": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["hp", "pos"],
        "properties": {
          "hp": { "type": "integer" },
          "pos": { "type": "string" }
        }
      }
    },
    "tiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["mod"],
        "properties": {
          "mod": { "type": "integer" }
        }
      }
    },
    "checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
