{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["type", "time"],
  "properties": {
    "type": {"type": "string"},
    "time": {"type": "integer", "minimum": 0},
    "node": {"type": "integer"},
    "term": {"type": "integer"},
    "ttl": {"type": "integer"},
    "token": {"type": "integer"},
    "write_id": {"type": "string"},
    "value": {"type": "integer"},
    "targets": {"type": "array", "items": {"type": "integer"}},
    "delta": {"type": "integer"}
  },
  "additionalProperties": true
}
