{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hwml.plaque/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scheme", "identity", "promoted", "finished", "mape", "r2",
    "mape_ceiling", "r2_floor", "design_digest", "beta_digest",
    "forecast_digest", "vault_digest", "fit_commit_digest",
    "pin_digest", "seal_digest", "trust_digest", "pin_seq", "policy_epoch"
  ],
  "properties": {
    "scheme": {"const": "hwml.plaque/v1"},
    "identity": {"type": "string"},
    "promoted": {"type": "boolean"},
    "finished": {"type": "boolean"},
    "mape": {"type": "number"},
    "r2": {"type": "number"},
    "mape_ceiling": {"type": "number"},
    "r2_floor": {"type": "number"},
    "design_digest": {"type": "string", "minLength": 64, "maxLength": 64},
    "beta_digest": {"type": "string", "minLength": 64, "maxLength": 64},
    "forecast_digest": {"type": "string", "minLength": 64, "maxLength": 64},
    "vault_digest": {"type": "string", "minLength": 64, "maxLength": 64},
    "fit_commit_digest": {"type": "string", "minLength": 64, "maxLength": 64},
    "pin_digest": {"type": "string", "minLength": 64, "maxLength": 64},
    "seal_digest": {"type": "string", "minLength": 64, "maxLength": 64},
    "trust_digest": {"type": "string", "minLength": 64, "maxLength": 64},
    "pin_seq": {"type": "integer", "minimum": 1},
    "policy_epoch": {"type": "integer", "minimum": 1}
  }
}
