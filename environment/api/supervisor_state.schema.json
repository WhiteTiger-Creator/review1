{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selected_profile",
    "profile_port",
    "port_source",
    "api_base_url",
    "health_probe_url",
    "listener_pid",
    "evidence",
    "counts"
  ],
  "properties": {
    "selected_profile": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
    "profile_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "port_source": { "enum": ["profile", "environment"] },
    "api_base_url": {
      "type": "string",
      "pattern": "^http://127\\.0\\.0\\.1:[0-9]+$"
    },
    "health_probe_url": {
      "type": "string",
      "pattern": "^http://127\\.0\\.0\\.1:[0-9]+/healthz$"
    },
    "listener_pid": { "type": "integer", "minimum": 2 },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strace_path", "lsof_path", "keyring_sha256"],
      "properties": {
        "strace_path": { "const": "/app/out/evidence/signing.strace" },
        "lsof_path": { "const": "/app/out/evidence/sockets.lsof" },
        "keyring_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "rejected", "replayed", "total"],
      "properties": {
        "accepted": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "replayed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
