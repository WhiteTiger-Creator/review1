#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "fileutils"
require_relative "../lib/core/work_bag"
require_relative "../lib/core/pass_ab"
require_relative "../lib/core/pass_cd"

ROOT = "/app/environment"
DATA = File.join(ROOT, "data")
OUT = "/app/output"

def parse_arms
  path = File.join(DATA, "ladder.toml")
  arms = []
  name = nil
  File.readlines(path).each do |line|
    line = line.strip
    if line.start_with?("name")
      name = line.split("=", 2)[1].strip.gsub('"', "")
    elsif line.start_with?("file")
      file = line.split("=", 2)[1].strip.gsub('"', "")
      arms << { "name" => name, "file" => file }
    end
  end
  arms
end

def resolve_pack(path, resume:, out_dir: OUT, journal: nil)
  bag = WorkBag.load_file(path)
  bag.out_dir = out_dir
  bag.journal_path = journal || File.join(DATA, ".warm", "journal.jsonl")
  FileUtils.mkdir_p(File.dirname(bag.journal_path))
  FileUtils.mkdir_p(out_dir)
  unless resume && File.file?(bag.journal_path)
    FileUtils.rm_f(bag.journal_path)
  end
  PassAb.run(bag, bag.wave, resume: resume)
  PassCd.run(bag)
  bag
end

def kip_scn_path(name)
  raw = name.end_with?(".json") ? name : "#{name}.json"
  pack = File.join(DATA, "kips", raw)
  raise "missing kip #{pack}" unless File.file?(pack)

  body = JSON.parse(File.read(pack))
  tmp = File.join(DATA, ".warm", "_kip_scn.json")
  FileUtils.mkdir_p(File.dirname(tmp))
  File.write(tmp, JSON.generate(body.fetch("scn")) + "\n")
  tmp
end

cmd = ARGV[0]
case cmd
when "build"
  FileUtils.mkdir_p(OUT)
  FileUtils.mkdir_p(File.join(DATA, ".warm"))
  puts "build ok"
when "play"
  resume = ARGV.include?("--resume")
  all = ARGV.include?("--all")
  kip_i = ARGV.index("--kip")
  if kip_i
    name = ARGV[kip_i + 1]
    stem = name.sub(/\.json\z/, "")
    side = File.join(DATA, ".warm", stem)
    resolve_pack(kip_scn_path(name), resume: false, out_dir: side, journal: File.join(side, "journal.jsonl"))
  else
    base = File.join(DATA, "scn_base.json")
    resolve_pack(base, resume: resume)
    if all
      parse_arms.each do |arm|
        side_out = File.join(DATA, ".warm", "arm_#{arm["name"]}")
        resolve_pack(
          File.join(DATA, arm["file"]),
          resume: false,
          out_dir: side_out,
          journal: File.join(side_out, "journal.jsonl")
        )
      end
    end
  end
  puts "play ok"
else
  warn "usage: tacts build|play [--all] [--resume] [--kip NAME]"
  exit 2
end
