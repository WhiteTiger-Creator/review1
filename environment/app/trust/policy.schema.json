{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recovered screening release policy",
  "type": "object",
  "additionalProperties": false,
  "x-field-order": [
    "allowed_model_kind",
    "assurance_weight",
    "candidate_snapshot_sha256",
    "compromise_decisions_sha256",
    "compromise_ledger_sha256",
    "delegation_state_sha256",
    "delegation_witnesses_sha256",
    "incident_id",
    "maximum_threshold",
    "minimum_threshold",
    "model_sha256",
    "previous_policy_sha256",
    "regions",
    "release_sequence",
    "signer_id",
    "signer_ids",
    "trust_roots"
  ],
  "required": [
    "allowed_model_kind",
    "assurance_weight",
    "candidate_snapshot_sha256",
    "compromise_decisions_sha256",
    "compromise_ledger_sha256",
    "delegation_state_sha256",
    "delegation_witnesses_sha256",
    "incident_id",
    "maximum_threshold",
    "minimum_threshold",
    "model_sha256",
    "previous_policy_sha256",
    "regions",
    "release_sequence",
    "signer_id",
    "signer_ids",
    "trust_roots"
  ],
  "properties": {
    "allowed_model_kind": {"const": "logistic_regression"},
    "assurance_weight": {"type": "integer", "minimum": 0},
    "candidate_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compromise_decisions_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compromise_ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "delegation_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "delegation_witnesses_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "incident_id": {"type": "string", "minLength": 1},
    "maximum_threshold": {"type": "number"},
    "minimum_threshold": {"type": "number"},
    "model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "previous_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "regions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "release_sequence": {"type": "integer", "minimum": 1},
    "signer_id": {"type": "string", "minLength": 1},
    "signer_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "trust_roots": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
