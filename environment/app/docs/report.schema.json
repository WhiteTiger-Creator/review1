{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://terminus.local/cargo-config-source-replacement-precedence-auditor/report.schema.json",
  "title": "CargoConfigSourceReplacementPrecedenceAuditorReport",
  "type": "object",
  "additionalProperties": false,
  "x-field-order": [
    "request_rows",
    "discovered_config_rows",
    "include_rows",
    "effective_value_rows",
    "path_resolution_rows",
    "source_rows",
    "replacement_edge_rows",
    "package_source_rows",
    "lock_reconciliation_rows",
    "integrity_rows",
    "build_rows",
    "rejection_rows",
    "summary"
  ],
  "required": [
    "request_rows",
    "discovered_config_rows",
    "include_rows",
    "effective_value_rows",
    "path_resolution_rows",
    "source_rows",
    "replacement_edge_rows",
    "package_source_rows",
    "lock_reconciliation_rows",
    "integrity_rows",
    "build_rows",
    "rejection_rows",
    "summary"
  ],
  "properties": {
    "request_rows": {
      "type": "array",
      "items": { "$ref": "#/definitions/RequestRow" }
    },
    "discovered_config_rows": {
      "type": "array",
      "items": { "$ref": "#/definitions/DiscoveredConfigRow" }
    },
    "include_rows": {
      "type": "array",
      "items": { "$ref": "#/definitions/IncludeRow" }
    },
    "effective_value_rows": {
      "type": "array",
      "items": { "$ref": "#/definitions/EffectiveValueRow" }
    },
    "path_resolution_rows": {
      "type": "array",
      "items": { "$ref": "#/definitions/PathResolutionRow" }
    },
    "source_rows": {
      "type": "array",
      "items": { "$ref": "#/definitions/SourceRow" }
    },
    "replacement_edge_rows": {
      "type": "array",
      "items": { "$ref": "#/definitions/ReplacementEdgeRow" }
    },
    "package_source_rows": {
      "type": "array",
      "items": { "$ref": "#/definitions/PackageSourceRow" }
    },
    "lock_reconciliation_rows": {
      "type": "array",
      "items": { "$ref": "#/definitions/LockReconciliationRow" }
    },
    "integrity_rows": {
      "type": "array",
      "items": { "$ref": "#/definitions/IntegrityRow" }
    },
    "build_rows": {
      "type": "array",
      "items": { "$ref": "#/definitions/BuildRow" }
    },
    "rejection_rows": {
      "type": "array",
      "items": { "$ref": "#/definitions/RejectionRow" }
    },
    "summary": { "$ref": "#/definitions/Summary" }
  },
  "definitions": {
    "RequestRow": {
      "type": "object",
      "additionalProperties": false,
      "x-field-order": [
        "request_id",
        "invocation_directory",
        "status",
        "reason_or_null",
        "discovered_config_count",
        "include_count",
        "effective_value_count",
        "terminal_source_count",
        "build_status"
      ],
      "x-sort-key": ["request_id"],
      "x-population": "One row per audit request.",
      "required": [
        "request_id",
        "invocation_directory",
        "status",
        "reason_or_null",
        "discovered_config_count",
        "include_count",
        "effective_value_count",
        "terminal_source_count",
        "build_status"
      ],
      "properties": {
        "request_id": { "type": "string" },
        "invocation_directory": { "type": "string" },
        "status": { "type": "string", "enum": ["accepted", "rejected"] },
        "reason_or_null": { "type": ["string", "null"] },
        "discovered_config_count": { "type": "integer", "minimum": 0 },
        "include_count": { "type": "integer", "minimum": 0 },
        "effective_value_count": { "type": "integer", "minimum": 0 },
        "terminal_source_count": { "type": "integer", "minimum": 0 },
        "build_status": {
          "type": "string",
          "enum": ["success", "failed", "skipped", "not_run"]
        }
      }
    },
    "DiscoveredConfigRow": {
      "type": "object",
      "additionalProperties": false,
      "x-field-order": [
        "request_id",
        "config_path",
        "discovery_depth",
        "load_order"
      ],
      "x-sort-key": ["request_id", "load_order", "config_path"],
      "x-population": "One row per discovered hierarchical .cargo/config.toml. load_order is 1-based shallow-to-deep.",
      "required": [
        "request_id",
        "config_path",
        "discovery_depth",
        "load_order"
      ],
      "properties": {
        "request_id": { "type": "string" },
        "config_path": { "type": "string" },
        "discovery_depth": { "type": "integer", "minimum": 0 },
        "load_order": { "type": "integer", "minimum": 1 }
      }
    },
    "IncludeRow": {
      "type": "object",
      "additionalProperties": false,
      "x-field-order": [
        "request_id",
        "including_file",
        "included_path",
        "optional",
        "exists",
        "include_depth",
        "load_order"
      ],
      "x-sort-key": ["request_id", "load_order", "included_path"],
      "x-population": "One row per include event. load_order is a separate 1-based include-event sequence per request (DFS pre-order, left-to-right, optional missing consumes a position).",
      "required": [
        "request_id",
        "including_file",
        "included_path",
        "optional",
        "exists",
        "include_depth",
        "load_order"
      ],
      "properties": {
        "request_id": { "type": "string" },
        "including_file": { "type": "string" },
        "included_path": { "type": "string" },
        "optional": { "type": "boolean" },
        "exists": { "type": "boolean" },
        "include_depth": { "type": "integer", "minimum": 1 },
        "load_order": { "type": "integer", "minimum": 1 }
      }
    },
    "EffectiveValueRow": {
      "type": "object",
      "additionalProperties": false,
      "x-field-order": [
        "request_id",
        "key",
        "value_type",
        "canonical_value",
        "defining_source",
        "merge_layer",
        "environment_override_or_null",
        "cli_override_sequence_or_null"
      ],
      "x-sort-key": ["request_id", "key"],
      "x-population": "One row per bounded effective configuration key.",
      "required": [
        "request_id",
        "key",
        "value_type",
        "canonical_value",
        "defining_source",
        "merge_layer",
        "environment_override_or_null",
        "cli_override_sequence_or_null"
      ],
      "properties": {
        "request_id": { "type": "string" },
        "key": { "type": "string" },
        "value_type": {
          "type": "string",
          "enum": ["string", "integer", "boolean", "array", "table"]
        },
        "canonical_value": { "type": "string" },
        "defining_source": { "type": "string" },
        "merge_layer": {
          "type": "string",
          "enum": ["config_file", "environment", "cli"]
        },
        "environment_override_or_null": { "type": ["string", "null"] },
        "cli_override_sequence_or_null": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "PathResolutionRow": {
      "type": "object",
      "additionalProperties": false,
      "x-field-order": [
        "request_id",
        "key",
        "raw_path",
        "base_path",
        "normalized_path",
        "exists"
      ],
      "x-sort-key": ["request_id", "key"],
      "x-population": "One row per resolved path-bearing bounded key.",
      "required": [
        "request_id",
        "key",
        "raw_path",
        "base_path",
        "normalized_path",
        "exists"
      ],
      "properties": {
        "request_id": { "type": "string" },
        "key": { "type": "string" },
        "raw_path": { "type": "string" },
        "base_path": { "type": "string" },
        "normalized_path": { "type": "string" },
        "exists": { "type": "boolean" }
      }
    },
    "SourceRow": {
      "type": "object",
      "additionalProperties": false,
      "x-field-order": [
        "request_id",
        "source_name",
        "source_kind",
        "replace_with_or_null",
        "terminal_source",
        "root_path_or_null"
      ],
      "x-sort-key": ["request_id", "source_name"],
      "x-population": "One row per effective source name. terminal_source is the terminal source name string.",
      "required": [
        "request_id",
        "source_name",
        "source_kind",
        "replace_with_or_null",
        "terminal_source",
        "root_path_or_null"
      ],
      "properties": {
        "request_id": { "type": "string" },
        "source_name": { "type": "string" },
        "source_kind": {
          "type": "string",
          "enum": ["replace", "directory", "local-registry"]
        },
        "replace_with_or_null": { "type": ["string", "null"] },
        "terminal_source": { "type": "string" },
        "root_path_or_null": { "type": ["string", "null"] }
      }
    },
    "ReplacementEdgeRow": {
      "type": "object",
      "additionalProperties": false,
      "x-field-order": [
        "request_id",
        "from_source",
        "to_source",
        "edge_index"
      ],
      "x-sort-key": ["request_id", "from_source", "edge_index", "to_source"],
      "x-population": "One row per traversed replace-with edge. edge_index is 1-based within the explored chain.",
      "required": [
        "request_id",
        "from_source",
        "to_source",
        "edge_index"
      ],
      "properties": {
        "request_id": { "type": "string" },
        "from_source": { "type": "string" },
        "to_source": { "type": "string" },
        "edge_index": { "type": "integer", "minimum": 1 }
      }
    },
    "PackageSourceRow": {
      "type": "object",
      "additionalProperties": false,
      "x-field-order": [
        "request_id",
        "package_name",
        "version",
        "original_source",
        "terminal_source",
        "relative_package_path"
      ],
      "x-sort-key": ["request_id", "package_name", "version"],
      "x-population": "One row per Cargo.lock registry package after terminal-source resolution.",
      "required": [
        "request_id",
        "package_name",
        "version",
        "original_source",
        "terminal_source",
        "relative_package_path"
      ],
      "properties": {
        "request_id": { "type": "string" },
        "package_name": { "type": "string" },
        "version": { "type": "string" },
        "original_source": { "type": "string" },
        "terminal_source": { "type": "string" },
        "relative_package_path": { "type": "string" }
      }
    },
    "LockReconciliationRow": {
      "type": "object",
      "additionalProperties": false,
      "x-field-order": [
        "request_id",
        "package_name",
        "version",
        "lock_source",
        "effective_source",
        "checksum",
        "status"
      ],
      "x-sort-key": ["request_id", "package_name", "version"],
      "x-population": "One row per registry package reaching lock reconciliation, including successful matched rows.",
      "required": [
        "request_id",
        "package_name",
        "version",
        "lock_source",
        "effective_source",
        "checksum",
        "status"
      ],
      "properties": {
        "request_id": { "type": "string" },
        "package_name": { "type": "string" },
        "version": { "type": "string" },
        "lock_source": { "type": "string" },
        "effective_source": { "type": "string" },
        "checksum": { "type": "string" },
        "status": {
          "type": "string",
          "enum": [
            "matched",
            "package_missing",
            "checksum_mismatch",
            "source_mismatch"
          ]
        }
      }
    },
    "IntegrityRow": {
      "type": "object",
      "additionalProperties": false,
      "x-field-order": [
        "request_id",
        "source_name",
        "package_name",
        "version",
        "integrity_kind",
        "status",
        "details"
      ],
      "x-sort-key": [
        "request_id",
        "package_name",
        "version",
        "integrity_kind",
        "details"
      ],
      "x-population": "Integrity checks for verified packages according to integrity_kind vocabulary.",
      "required": [
        "request_id",
        "source_name",
        "package_name",
        "version",
        "integrity_kind",
        "status",
        "details"
      ],
      "properties": {
        "request_id": { "type": "string" },
        "source_name": { "type": "string" },
        "package_name": { "type": "string" },
        "version": { "type": "string" },
        "integrity_kind": {
          "type": "string",
          "enum": [
            "directory_identity",
            "directory_checksum",
            "directory_file",
            "directory_symlink",
            "directory_unexpected_file",
            "local_registry_index",
            "local_registry_archive",
            "local_registry_identity",
            "local_registry_path"
          ]
        },
        "status": { "type": "string" },
        "details": { "type": "string" }
      }
    },
    "BuildRow": {
      "type": "object",
      "additionalProperties": false,
      "x-field-order": [
        "request_id",
        "status",
        "exit_code",
        "lock_unchanged",
        "source_bytes_unchanged",
        "artifact_count"
      ],
      "x-sort-key": ["request_id"],
      "x-population": "Exactly one row per run_build=true accepted request that reaches build. Successful artifact_count is 1 (final cli executable only).",
      "required": [
        "request_id",
        "status",
        "exit_code",
        "lock_unchanged",
        "source_bytes_unchanged",
        "artifact_count"
      ],
      "properties": {
        "request_id": { "type": "string" },
        "status": { "type": "string", "enum": ["success", "failed"] },
        "exit_code": { "type": "integer" },
        "lock_unchanged": { "type": "boolean" },
        "source_bytes_unchanged": { "type": "boolean" },
        "artifact_count": { "type": "integer", "minimum": 0 }
      }
    },
    "RejectionRow": {
      "type": "object",
      "additionalProperties": false,
      "x-field-order": [
        "request_id",
        "stage",
        "reason",
        "path_or_source_or_null",
        "details"
      ],
      "x-sort-key": ["request_id", "stage", "reason"],
      "x-population": "One row per request-level rejection.",
      "required": [
        "request_id",
        "stage",
        "reason",
        "path_or_source_or_null",
        "details"
      ],
      "properties": {
        "request_id": { "type": "string" },
        "stage": { "type": "string" },
        "reason": { "type": "string" },
        "path_or_source_or_null": { "type": ["string", "null"] },
        "details": { "type": "string" }
      }
    },
    "Summary": {
      "type": "object",
      "additionalProperties": false,
      "x-field-order": [
        "request_count",
        "accepted_request_count",
        "rejected_request_count",
        "discovered_config_count",
        "include_count",
        "effective_source_count",
        "verified_package_count",
        "successful_build_count",
        "failed_build_count"
      ],
      "x-population": "Aggregate counters for the whole report.",
      "required": [
        "request_count",
        "accepted_request_count",
        "rejected_request_count",
        "discovered_config_count",
        "include_count",
        "effective_source_count",
        "verified_package_count",
        "successful_build_count",
        "failed_build_count"
      ],
      "properties": {
        "request_count": { "type": "integer", "minimum": 0 },
        "accepted_request_count": { "type": "integer", "minimum": 0 },
        "rejected_request_count": { "type": "integer", "minimum": 0 },
        "discovered_config_count": { "type": "integer", "minimum": 0 },
        "include_count": { "type": "integer", "minimum": 0 },
        "effective_source_count": { "type": "integer", "minimum": 0 },
        "verified_package_count": { "type": "integer", "minimum": 0 },
        "successful_build_count": { "type": "integer", "minimum": 0 },
        "failed_build_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
