{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aurora-legacy-profiles-v1.schema.json",
  "type": "object",
  "required": ["format", "profiles", "jobs"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "aurora-profile-v1" },
    "profiles": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/flat_profile" }
    },
    "jobs": {
      "type": "array",
      "items": { "$ref": "#/$defs/job" }
    }
  },
  "$defs": {
    "flat_profile": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "delivery_profile": { "type": "string" },
        "width": { "type": ["integer", "null"] },
        "height": { "type": ["integer", "null"] },
        "subtitle_mode": { "type": "string" },
        "audio_normalization": { "type": ["object", "null"] }
      }
    },
    "job": {
      "type": "object",
      "required": ["asset_id", "profile", "artifact_name"],
      "additionalProperties": false,
      "properties": {
        "asset_id": { "type": "string" },
        "profile": { "type": "string" },
        "artifact_name": { "type": "string" }
      }
    }
  }
}