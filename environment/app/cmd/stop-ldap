#!/usr/bin/env bash
set -euo pipefail

source /app/lib/common.sh

stop_one() {
  local role="$1"
  local pidfile="${LDAP_RUNTIME}/${role}.pid"
  if [[ -f "${pidfile}" ]]; then
    local pid
    pid="$(cat "${pidfile}")"
    if kill -0 "${pid}" 2>/dev/null; then
      kill "${pid}" || true
      for _ in $(seq 1 30); do
        kill -0 "${pid}" 2>/dev/null || break
        sleep 1
      done
      kill -9 "${pid}" 2>/dev/null || true
    fi
    rm -f "${pidfile}" "${LDAP_RUNTIME}/${role}.args"
  fi
}

stop_one provider
stop_one consumer
