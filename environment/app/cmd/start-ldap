#!/usr/bin/env bash
set -euo pipefail

source /app/lib/common.sh

mkdir -p "${LDAP_RUNTIME}" /app/ldap/provider/data /app/ldap/provider/accesslog \
  /app/ldap/provider/verifier-data /app/ldap/consumer/data /app/ldap/consumer/verifier-data \
  /app/config/provider /app/config/consumer

default_server_id() {
  local role="$1"
  if [[ "${role}" == provider ]]; then
    echo 1
  else
    echo 2
  fi
}

render_conf() {
  local role="$1"
  local template="/app/config/${role}/slapd.conf.in"
  local output="/app/ldap/${role}/slapd.conf"
  local identity="/app/config/${role}/server-id"
  local sid
  if [[ -f "${identity}" ]]; then
    sid="$(tr -d '[:space:]' <"${identity}")"
  else
    sid="$(default_server_id "${role}")"
    printf '%s\n' "${sid}" >"${identity}"
  fi
  sed "s/@SERVER_ID@/${sid}/g" "${template}" >"${output}"
}

render_conf provider
render_conf consumer

start_one() {
  local role="$1"
  local uri="$2"
  local conf="/app/ldap/${role}/slapd.conf"
  local pidfile="${LDAP_RUNTIME}/${role}.pid"
  local argsfile="${LDAP_RUNTIME}/${role}.args"
  if [[ -f "${pidfile}" ]]; then
    local pid
    pid="$(cat "${pidfile}")"
    if kill -0 "${pid}" 2>/dev/null; then
      return 0
    fi
  fi
  rm -f "${pidfile}" "${argsfile}"
  slapd -f "${conf}" -h "${uri}" -u openldap -g openldap
  wait_for_port "${uri}" 60 1
}

start_one provider "${PROVIDER_URI}"
start_one consumer "${CONSUMER_URI}"
