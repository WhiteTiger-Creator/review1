#!/usr/bin/env python3
"""Hallwarden ML CLI — vault | forecast | emit | eval."""
from __future__ import annotations
import sys

from latchml.driver import run_eval, run_vault, run_forecast, run_emit


def main(argv):
    if len(argv) < 2 or argv[1] not in ("vault", "forecast", "emit", "eval"):
        print("usage: hwml vault|forecast|emit|eval", file=sys.stderr)
        return 2
    mode = argv[1]
    try:
        if mode == "vault":
            r = run_vault()
            print(f"vault_rows={len(r['vault'].get('rows', []))}")
            return 0
        if mode == "forecast":
            r = run_forecast()
            c = r["plaque"]
            print(f"promoted={c.get('promoted')} mape={c.get('mape')} r2={c.get('r2')}")
            return 0
        if mode == "emit":
            r = run_emit()
            c = r["plaque"]
            print(f"promoted={c.get('promoted')} mape={c.get('mape')} r2={c.get('r2')}")
            return 0
        r = run_eval()
        c = r["plaque"]
        print(f"promoted={c.get('promoted')} mape={c.get('mape')} r2={c.get('r2')}")
        return 0
    except SystemExit as e:
        code = e.code if isinstance(e.code, int) else 1
        return code
    except Exception as exc:
        print(str(exc), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
