#!/bin/bash
set -euo pipefail

usage='usage: frr-policy-render POLICY_ROOT BASELINE OUTPUT'
if [ "$#" -ne 3 ]; then
  echo "$usage" >&2
  exit 64
fi

root=${1%/}
baseline=$2
output=$3
declare -A value seen

fail() {
  echo "policy: $*" >&2
  exit 2
}

load_kv() {
  local tag=$1 path=$2 allowed=" ${*:3} " line key item val
  [[ -f $path && ! -L $path ]] || fail "invalid file $path"
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line//$'\r'/}
    [[ $line =~ ^[[:space:]]*$ || $line =~ ^[[:space:]]*# ]] && continue
    [[ $line == *"="* ]] || fail "malformed line in $path"
    key=${line%%=*}
    val=${line#*=}
    key="${key#"${key%%[![:space:]]*}"}"
    key="${key%"${key##*[![:space:]]}"}"
    val="${val#"${val%%[![:space:]]*}"}"
    val="${val%"${val##*[![:space:]]}"}"
    [[ -n $key && -n $val && $allowed == *" $key "* ]] ||
      fail "unknown or empty key in $path"
    [[ -z ${seen["$tag.$key"]+x} ]] || fail "duplicate key $key in $path"
    seen["$tag.$key"]=1
    value["$tag.$key"]=$val
  done < "$path"
  for item in ${*:3}; do
    [[ -n ${seen["$tag.$item"]+x} ]] || fail "missing key $item in $path"
  done
}

v() { printf '%s' "${value["$1.$2"]}"; }
eq() { [[ $(v "$1" "$2") == "$3" ]] || fail "$1.$2 mismatch"; }
same() { [[ $(v "$1" "$2") == $(v "$3" "$4") ]] || fail "$1.$2 mismatch"; }
uint() {
  local n
  n=$(v "$1" "$2")
  [[ $n =~ ^[1-9][0-9]*$ ]] || fail "$1.$2 is not a canonical integer"
  (( 10#$n >= "$3" && 10#$n <= "$4" )) || fail "$1.$2 is out of range"
}
identifier() {
  [[ $(v "$1" "$2") =~ ^[[:alnum:]][[:alnum:]_-]{0,63}$ ]] ||
    fail "$1.$2 is not a safe identifier"
}
ipcheck() {
  local mode=${3:-address}
  python3 - "$1" "$2" "$mode" <<'PY' >/dev/null 2>&1 || fail "invalid $2 $mode"
import ipaddress, sys
text, family, mode = sys.argv[1:]
if mode == "network":
    obj = ipaddress.ip_network(text, strict=True)
elif mode == "interface":
    obj = ipaddress.ip_interface(text)
else:
    if "/" in text:
        raise ValueError("plain address required")
    obj = ipaddress.ip_address(text)
want = 4 if sys.argv[2] == "ipv4" else 6
raise SystemExit(0 if obj.version == want else 1)
PY
}

expected_policy=$(printf '%s\n' \
  advertisements/ipv4.conf advertisements/ipv6.conf maintenance/window.conf \
  peers/transit-a-v4.conf peers/transit-a-v6.conf \
  peers/transit-b-v4.conf peers/transit-b-v6.conf \
  preferences/maintenance.conf preferences/normal.conf \
  prefix-lists/ipv4.conf prefix-lists/ipv6.conf \
  route-maps/inbound-primary.conf route-maps/inbound-standby.conf \
  route-maps/outbound-standby.conf visibility.conf | sort)
observed_policy=$(
  find "$root" \( -type f -o -type l \) -name '*.conf' -printf '%P\n' 2>/dev/null | sort
) || fail "cannot enumerate policy root"
[[ $observed_policy == "$expected_policy" ]] || fail "policy file set mismatch"

load_kv maint "$root/maintenance/window.conf" change_id router primary standby profile approval
load_kv vis "$root/visibility.conf" change_id ipv4_resource ipv6_resource expected_origin min_visibility_percent standby_profile
load_kv adv4 "$root/advertisements/ipv4.conf" family aggregate origin exact_only
load_kv adv6 "$root/advertisements/ipv6.conf" family aggregate origin exact_only
load_kv pav4 "$root/peers/transit-a-v4.conf" name role family neighbor remote_as
load_kv pav6 "$root/peers/transit-a-v6.conf" name role family neighbor remote_as
load_kv psv4 "$root/peers/transit-b-v4.conf" name role family neighbor remote_as
load_kv psv6 "$root/peers/transit-b-v6.conf" name role family neighbor remote_as
load_kv pref "$root/preferences/maintenance.conf" primary_local_preference standby_local_preference
load_kv normal "$root/preferences/normal.conf" primary_local_preference standby_local_preference
load_kv pl4 "$root/prefix-lists/ipv4.conf" name sequence action prefix range
load_kv pl6 "$root/prefix-lists/ipv6.conf" name sequence action prefix range
load_kv rmp "$root/route-maps/inbound-primary.conf" name direction action sequence local_preference
load_kv rms "$root/route-maps/inbound-standby.conf" name direction action sequence local_preference
load_kv rmo "$root/route-maps/outbound-standby.conf" name direction ipv4_prefix_list ipv6_prefix_list default

inventory_root="$root/../inventory"
inventory="$inventory_root/router.csv"
interfaces="$inventory_root/interfaces.csv"
contacts="$inventory_root/contacts.csv"
for inventory_file in "$inventory" "$interfaces" "$contacts"; do
  [[ -f $inventory_file && ! -L $inventory_file ]] || fail "invalid inventory $inventory_file"
done
IFS= read -r header < "$inventory"
[[ $header == 'hostname,site,asn,router_id,role' ]] || fail "router inventory header"
matches=0 router_as= router_id=
while IFS=, read -r host site asn rid role extra; do
  [[ -n $host ]] || continue
  [[ -z ${extra:-} && -n $site && -n $asn && -n $rid && -n $role && $host != *[[:space:]]* ]] || fail "router inventory row"
  if [[ $host == $(v maint router) ]]; then
    ((matches+=1))
    router_as=$asn
    router_id=$rid
    [[ $role == edge ]] || fail "router role"
  fi
done < <(tail -n +2 "$inventory")
[[ $matches -eq 1 ]] || fail "router inventory match"

declare -A local_address purpose_count interface_seen address_seen
IFS= read -r header < "$interfaces"
[[ $header == 'hostname,interface,address,purpose' ]] || fail "interfaces inventory header"
while IFS=, read -r host iface address purpose extra; do
  [[ -n $host ]] || continue
  [[ -z ${extra:-} && -n $iface && -n $address && -n $purpose ]] || fail "interfaces inventory row"
  if [[ $host == $(v maint router) ]]; then
    [[ -z ${interface_seen[$iface]+x} && -z ${address_seen[$address]+x} ]] || fail "duplicate router interface"
    interface_seen[$iface]=1
    address_seen[$address]=1
    purpose_count[$purpose]=$((${purpose_count[$purpose]:-0} + 1))
    local_address[$purpose]=$address
  fi
done < <(tail -n +2 "$interfaces")
for purpose in router-id "$(v maint primary)-v4" "$(v maint primary)-v6" "$(v maint standby)-v4" "$(v maint standby)-v6"; do
  [[ ${purpose_count[$purpose]:-0} -eq 1 ]] || fail "interface purpose $purpose"
done
[[ ${#purpose_count[@]} -eq 5 ]] || fail "unexpected router interface purpose"

declare -A contact_count contact_pair
IFS= read -r header < "$contacts"
[[ $header == 'role,team,channel' ]] || fail "contacts inventory header"
while IFS=, read -r contact_role team channel extra; do
  [[ -n $contact_role ]] || continue
  [[ -z ${extra:-} && -n $team && -n $channel ]] || fail "contacts inventory row"
  case $contact_role in change-owner|rollback-owner|observer) ;; *) fail "unknown contact role" ;; esac
  contact_count[$contact_role]=$((${contact_count[$contact_role]:-0} + 1))
  [[ -z ${contact_pair["$team,$channel"]+x} ]] || fail "duplicate contact destination"
  contact_pair["$team,$channel"]=1
done < <(tail -n +2 "$contacts")
for contact_role in change-owner rollback-owner observer; do
  [[ ${contact_count[$contact_role]:-0} -eq 1 ]] || fail "contact role $contact_role"
done

[[ -f $baseline && ! -L $baseline ]] || fail "invalid baseline"
[[ $(stat -c %h "$baseline") -eq 1 ]] || fail "multiply-linked baseline"
mapfile -t version_lines < <(grep -E '^frr version ' "$baseline" || true)
mapfile -t defaults_lines < <(grep -E '^frr defaults ' "$baseline" || true)
mapfile -t service_lines < <(grep -E '^service integrated-vtysh-config$' "$baseline" || true)
[[ ${#version_lines[@]} -eq 1 && ${#defaults_lines[@]} -eq 1 && ${#service_lines[@]} -eq 1 ]] ||
  fail "baseline globals"

same maint change_id vis change_id
same maint profile vis standby_profile
eq maint approval approved
eq pav4 role primary; eq pav6 role primary; eq psv4 role standby; eq psv6 role standby
same pav4 name maint primary; same pav6 name maint primary
same psv4 name maint standby; same psv6 name maint standby
eq pav4 family ipv4; eq psv4 family ipv4; eq pav6 family ipv6; eq psv6 family ipv6
same pav4 remote_as pav6 remote_as; same psv4 remote_as psv6 remote_as
[[ $(v maint primary) != $(v maint standby) ]] || fail "peer names collide"
[[ $(v pav4 remote_as) != $(v psv4 remote_as) ]] || fail "peer ASNs collide"
eq adv4 family ipv4; eq adv6 family ipv6
same adv4 aggregate vis ipv4_resource; same adv6 aggregate vis ipv6_resource
[[ $(v adv4 origin) == "$router_as" && $(v adv6 origin) == "$router_as" && $(v vis expected_origin) == "$router_as" ]] || fail "origin mismatch"
eq adv4 exact_only true; eq adv6 exact_only true
eq pl4 action permit; eq pl6 action permit; eq pl4 range exact; eq pl6 range exact
same pl4 prefix adv4 aggregate; same pl6 prefix adv6 aggregate
eq rmp direction in; eq rms direction in; eq rmp action permit; eq rms action permit
same rmp local_preference pref primary_local_preference
same rms local_preference pref standby_local_preference
(( 10#$(v normal primary_local_preference) > 10#$(v normal standby_local_preference) )) || fail "normal preference ordering"
(( 10#$(v pref standby_local_preference) > 10#$(v pref primary_local_preference) )) || fail "maintenance preference ordering"
eq rmo direction out; eq rmo default deny
same rmo ipv4_prefix_list pl4 name; same rmo ipv6_prefix_list pl6 name

for pair in 'vis min_visibility_percent 1 100' 'adv4 origin 1 4294967295' 'adv6 origin 1 4294967295' \
  'pav4 remote_as 1 4294967295' 'pav6 remote_as 1 4294967295' 'psv4 remote_as 1 4294967295' \
  'psv6 remote_as 1 4294967295' 'pref primary_local_preference 1 4294967295' \
  'pref standby_local_preference 1 4294967295' 'normal primary_local_preference 1 4294967295' \
  'normal standby_local_preference 1 4294967295' 'pl4 sequence 1 4294967295' 'pl6 sequence 1 4294967295' \
  'rmp sequence 1 4294967295' 'rms sequence 1 4294967295'; do
  read -r tag key low high <<< "$pair"; uint "$tag" "$key" "$low" "$high"
done
[[ $router_as =~ ^[1-9][0-9]*$ ]] && (( 10#$router_as >= 1 && 10#$router_as <= 4294967295 )) || fail "router ASN"
for field in 'maint router' 'maint primary' 'maint standby' 'maint profile' 'vis standby_profile' \
  'pl4 name' 'pl6 name' 'rmp name' 'rms name' 'rmo name'; do
  read -r tag key <<< "$field"; identifier "$tag" "$key"
done
ipcheck "$router_id" ipv4
ipcheck "$(v adv4 aggregate)" ipv4 network; ipcheck "$(v adv6 aggregate)" ipv6 network
ipcheck "$(v pav4 neighbor)" ipv4; ipcheck "$(v psv4 neighbor)" ipv4
ipcheck "$(v pav6 neighbor)" ipv6; ipcheck "$(v psv6 neighbor)" ipv6
[[ $(v pav4 neighbor) != $(v psv4 neighbor) && $(v pav6 neighbor) != $(v psv6 neighbor) ]] || fail "peer addresses collide"
[[ $(v pav4 remote_as) != "$router_as" && $(v psv4 remote_as) != "$router_as" ]] || fail "remote ASN equals local ASN"

python3 - "$router_id" "${local_address[router-id]}" \
  "$(v pav4 neighbor)" "${local_address["$(v maint primary)-v4"]}" \
  "$(v pav6 neighbor)" "${local_address["$(v maint primary)-v6"]}" \
  "$(v psv4 neighbor)" "${local_address["$(v maint standby)-v4"]}" \
  "$(v psv6 neighbor)" "${local_address["$(v maint standby)-v6"]}" <<'PY' >/dev/null 2>&1 || fail "interface adjacency mismatch"
import ipaddress, sys
router_id, loopback, *pairs = sys.argv[1:]
loop = ipaddress.ip_interface(loopback)
assert loop.version == 4 and loop.network.prefixlen == 32 and str(loop.ip) == router_id
for peer_text, local_text in zip(pairs[::2], pairs[1::2]):
    peer = ipaddress.ip_address(peer_text)
    local = ipaddress.ip_interface(local_text)
    assert peer.version == local.version and peer in local.network and peer != local.ip
    if peer.version == 4:
        assert peer not in (local.network.network_address, local.network.broadcast_address)
PY

mapfile -t hostname_lines < <(grep -E '^hostname ' "$baseline" || true)
mapfile -t bgp_lines < <(grep -E '^router bgp ' "$baseline" || true)
mapfile -t router_id_lines < <(grep -E '^[[:space:]]+bgp router-id ' "$baseline" || true)
[[ ${#hostname_lines[@]} -eq 1 && ${hostname_lines[0]} == "hostname $(v maint router)" ]] || fail "baseline hostname"
[[ ${#bgp_lines[@]} -eq 1 && ${bgp_lines[0]} == "router bgp $router_as" ]] || fail "baseline BGP ASN"
[[ ${#router_id_lines[@]} -eq 1 && ${router_id_lines[0]} == " bgp router-id $router_id" ]] || fail "baseline router ID"
mapfile -t baseline_networks < <(sed -n -E 's/^[[:space:]]+network ([^[:space:]]+)$/\1/p' "$baseline")
[[ ${#baseline_networks[@]} -eq 2 && ${baseline_networks[0]} == $(v adv4 aggregate) && ${baseline_networks[1]} == $(v adv6 aggregate) ]] || fail "baseline networks"
mapfile -t baseline_neighbors < <(sed -n -E 's/^[[:space:]]+neighbor ([^[:space:]]+) remote-as ([^[:space:]]+)$/\1=\2/p' "$baseline")
expected_neighbors=("$(v pav4 neighbor)=$(v pav4 remote_as)" "$(v psv4 neighbor)=$(v psv4 remote_as)" "$(v pav6 neighbor)=$(v pav6 remote_as)" "$(v psv6 neighbor)=$(v psv6 remote_as)")
[[ ${#baseline_neighbors[@]} -eq 4 ]] || fail "baseline neighbor count"
for neighbor in "${expected_neighbors[@]}"; do
  [[ " ${baseline_neighbors[*]} " == *" $neighbor "* ]] || fail "baseline neighbor $neighbor"
done

if [[ -e $output || -L $output ]]; then
  [[ -f $output && ! -L $output ]] || fail "unsafe output path"
  [[ $(stat -c %h "$output") -eq 1 ]] || fail "multiply-linked output"
fi
outdir=$(dirname "$output")
[[ -d $outdir && ! -L $outdir ]] || fail "unsafe output directory"
for input in "$baseline" "$inventory" "$interfaces" "$contacts"; do
  [[ ! -e $output || ! $output -ef $input ]] || fail "output aliases input"
done
while IFS= read -r input; do
  [[ ! -e $output || ! $output -ef $input ]] || fail "output aliases policy"
done < <(find "$root" -type f -name '*.conf')
umask 077
tmp=$(mktemp "$outdir/.frr-policy-render.XXXXXX") || exit 3
trap 'rm -f "$tmp"' EXIT
{
  printf '%s\n%s\n' "${version_lines[0]}" "${defaults_lines[0]}"
  printf 'hostname %s\n%s\n!\n' "$(v maint router)" "${service_lines[0]}"
  printf 'ip prefix-list %s seq %s permit %s\n' "$(v pl4 name)" "$(v pl4 sequence)" "$(v pl4 prefix)"
  printf 'ipv6 prefix-list %s seq %s permit %s\n!\n' "$(v pl6 name)" "$(v pl6 sequence)" "$(v pl6 prefix)"
  printf 'route-map %s permit %s\n set local-preference %s\nexit\n!\n' "$(v rmp name)" "$(v rmp sequence)" "$(v rmp local_preference)"
  printf 'route-map %s permit %s\n set local-preference %s\nexit\n!\n' "$(v rms name)" "$(v rms sequence)" "$(v rms local_preference)"
  printf 'route-map %s permit 10\n match ip address prefix-list %s\nexit\n!\n' "$(v rmo name)" "$(v pl4 name)"
  printf 'route-map %s permit 20\n match ipv6 address prefix-list %s\nexit\n!\n' "$(v rmo name)" "$(v pl6 name)"
  printf 'route-map %s deny 100\nexit\n!\n' "$(v rmo name)"
  printf 'router bgp %s\n bgp router-id %s\n no bgp ebgp-requires-policy\n' "$router_as" "$router_id"
  printf ' neighbor %s remote-as %s\n' "$(v pav4 neighbor)" "$(v pav4 remote_as)"
  printf ' neighbor %s remote-as %s\n' "$(v psv4 neighbor)" "$(v psv4 remote_as)"
  printf ' neighbor %s remote-as %s\n' "$(v pav6 neighbor)" "$(v pav6 remote_as)"
  printf ' neighbor %s remote-as %s\n !\n address-family ipv4 unicast\n' "$(v psv6 neighbor)" "$(v psv6 remote_as)"
  printf '  network %s\n' "$(v adv4 aggregate)"
  printf '  neighbor %s route-map %s in\n' "$(v pav4 neighbor)" "$(v rmp name)"
  printf '  neighbor %s route-map %s in\n' "$(v psv4 neighbor)" "$(v rms name)"
  printf '  neighbor %s route-map %s out\n exit-address-family\n !\n' "$(v psv4 neighbor)" "$(v rmo name)"
  printf ' address-family ipv6 unicast\n  network %s\n' "$(v adv6 aggregate)"
  printf '  neighbor %s activate\n  neighbor %s route-map %s in\n' "$(v pav6 neighbor)" "$(v pav6 neighbor)" "$(v rmp name)"
  printf '  neighbor %s activate\n  neighbor %s route-map %s in\n' "$(v psv6 neighbor)" "$(v psv6 neighbor)" "$(v rms name)"
  printf '  neighbor %s route-map %s out\n exit-address-family\nexit\n!\nend\n' "$(v psv6 neighbor)" "$(v rmo name)"
} > "$tmp"
chmod 0640 "$tmp"
/usr/bin/vtysh -C -f "$tmp" >/dev/null 2>&1 || fail "generated candidate failed FRR validation"
mv -fT "$tmp" "$output"
trap - EXIT
