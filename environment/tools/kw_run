#!/usr/bin/env ruby
# frozen_string_literal: true

# Resolve through symlinks so /usr/local/bin/kw_run still finds environment/.
here = File.dirname(File.realpath(__FILE__))
root = File.expand_path("..", here)
ENV["KW_ROOT"] ||= root
$LOAD_PATH.unshift(root)

require File.join(root, "q3z", "boot")

exit Q3z::Boot.run!(ARGV)
