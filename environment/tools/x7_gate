#!/usr/bin/env python3
"""Observation emitter for x7 matrix cells (raw fields only; not ground truth)."""

from __future__ import annotations

import argparse
import hashlib
import json
import math
import struct
import sys
from pathlib import Path

import h5py

ROOT = Path("/app/environment")
DEFAULT_STAGE = Path("/app/output/stage")


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def pack_digest(values: list[float]) -> str:
    payload = b"".join(struct.pack("<d", float(v)) for v in values)
    return hashlib.sha256(payload).hexdigest()


def _finite(vals: list[float], label: str) -> None:
    for i, v in enumerate(vals):
        if not math.isfinite(v):
            raise ValueError(f"{label}: non-finite value at index {i}")


def read_global_owned(h5_path: Path, n_global: int) -> list[float]:
    if not h5_path.is_file():
        raise FileNotFoundError(f"missing final artifact: {h5_path}")
    try:
        with h5py.File(h5_path, "r") as f:
            if "owned" not in f:
                raise ValueError(f"{h5_path}: missing owned dataset")
            arr = f["owned"][...]
            if int(arr.size) != int(n_global):
                raise ValueError(
                    f"{h5_path}: owned length {arr.size} != n_global {n_global}"
                )
            vals = [float(x) for x in arr]
            _finite(vals, f"{h5_path}:owned")
            return vals
    except OSError as exc:
        raise ValueError(f"malformed HDF5: {h5_path}: {exc}") from exc


def read_hist(h5_path: Path) -> tuple[list[float], list[float]]:
    if not h5_path.is_file():
        raise FileNotFoundError(f"missing final artifact: {h5_path}")
    try:
        with h5py.File(h5_path, "r") as f:
            if "hist" not in f:
                raise ValueError(f"{h5_path}: missing /hist")
            hg = f["hist"]
            if "dt_seq" not in hg or "mass_seq" not in hg:
                raise ValueError(f"{h5_path}: missing history datasets")
            dt = [float(x) for x in hg["dt_seq"][...]]
            ms = [float(x) for x in hg["mass_seq"][...]]
            if not dt or not ms:
                raise ValueError(f"{h5_path}: empty history sequences")
            _finite(dt, f"{h5_path}:dt_seq")
            _finite(ms, f"{h5_path}:mass_seq")
            return dt, ms
    except OSError as exc:
        raise ValueError(f"malformed HDF5: {h5_path}: {exc}") from exc


def read_ctrl(h5_path: Path) -> dict:
    with h5py.File(h5_path, "r") as f:
        if "ctrl" not in f:
            return {}
        c = f["ctrl"]
        return {
            "last_dt": float(c.attrs.get("last_dt", 0.0)),
            "n_reject": int(c.attrs.get("n_reject", 0)),
            "n_accept": int(c.attrs.get("n_accept", 0)),
            "accum": float(c.attrs.get("accum", 0.0)),
        }


def read_selected_generation(ckpt: Path, cell_dir: Path) -> int:
    picked = cell_dir / "continue" / "picked.json"
    if picked.exists():
        return int(json.loads(picked.read_text()).get("gen_id", 0))
    with h5py.File(ckpt, "r") as f:
        ids = []
        for name in f.keys():
            if name.startswith("gen_"):
                try:
                    ids.append(int(name.split("_", 1)[1]))
                except ValueError:
                    pass
        if ids:
            return max(ids)
        return int(f.attrs.get("gen_id", 0))


def cfg_for(tag: str) -> dict:
    cfg_path = ROOT / "cfg_store" / f"cfg_{tag}.json"
    return json.loads(cfg_path.read_text())


def pick_ckpt(cell_dir: Path) -> Path:
    leg = cell_dir / "legacy.h5"
    if leg.is_file():
        return leg
    ck = cell_dir / "ckpt.h5"
    if not ck.is_file():
        raise FileNotFoundError(f"missing matrix checkpoint under {cell_dir}")
    return ck


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--matrix-full", action="store_true")
    ap.add_argument("--out", required=True)
    ap.add_argument("--final", required=True)
    ap.add_argument("--stage", default=str(DEFAULT_STAGE))
    args = ap.parse_args()

    stage = Path(args.stage)
    final_path = Path(args.final)
    if not final_path.is_file():
        print(f"x7_gate: required final artifact missing: {final_path}", file=sys.stderr)
        return 1

    scenarios = ["sa", "sb", "sc"]
    profiles = ["px", "qy"]
    transitions = ["n2_to_n5", "n5_to_n3", "n3_to_n4", "n4_same"]

    cells = []
    fixture_hashes = {}

    try:
        for scen in scenarios:
            for prof in profiles:
                for tr in transitions:
                    cell_id = f"{scen}_{prof}_{tr}"
                    cell_dir = stage / cell_id
                    un_h5 = cell_dir / "uninterrupted" / "final.h5"
                    co_h5 = cell_dir / "continue" / "final.h5"
                    ckpt = pick_ckpt(cell_dir)
                    fixture_hashes[f"{scen}_{prof}_{tr}"] = sha256_file(ckpt)
                    cfg = cfg_for(scen)
                    n_global = int(cfg["n_global"])

                    un_vals = read_global_owned(un_h5, n_global)
                    co_vals = read_global_owned(co_h5, n_global)
                    un_digest = pack_digest(un_vals)
                    co_digest = pack_digest(co_vals)

                    read_hist(un_h5)
                    co_dt, co_mass = read_hist(co_h5)
                    sel_gen = read_selected_generation(ckpt, cell_dir)
                    ctrl = read_ctrl(co_h5)

                    cells.append(
                        {
                            "scenario": scen,
                            "profile": prof,
                            "transition": tr,
                            "selected_generation": sel_gen,
                            "field_digest": co_digest,
                            "mass_history": co_mass,
                            "timestep_seq": co_dt,
                            "controller": ctrl,
                            "uninterrupted_digest": un_digest,
                            "continued_digest": co_digest,
                            "fixture_sha256": sha256_file(ckpt),
                            "until_step": cfg["until_step"],
                        }
                    )
    except (OSError, ValueError, FileNotFoundError, KeyError, TypeError) as exc:
        print(f"x7_gate: {exc}", file=sys.stderr)
        return 1

    out_path = Path(args.out)
    out_path.parent.mkdir(parents=True, exist_ok=True)
    payload = {
        "cells": cells,
        "fixture_sha256": fixture_hashes,
        "matrix": {
            "scenarios": scenarios,
            "profiles": profiles,
            "transitions": transitions,
        },
    }
    out_path.write_text(json.dumps(payload, indent=2) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
