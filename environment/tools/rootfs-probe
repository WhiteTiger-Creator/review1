#!/usr/bin/env bash
set -euo pipefail
while [[ $# -gt 0 ]]; do
  case "$1" in
    --root) ROOT="$2"; shift 2 ;;
    --image) IMAGE="$2"; shift 2 ;;
    *) shift ;;
  esac
done
ROOT="${ROOT:-/var/lib/mint}"
IMAGE="${IMAGE:-demo}"
if [ -f "$ROOT/manifests/${IMAGE}.json" ]; then
  echo "probe-ok:${IMAGE}"
  exit 0
fi
echo "probe-missing-manifest" >&2
exit 1
