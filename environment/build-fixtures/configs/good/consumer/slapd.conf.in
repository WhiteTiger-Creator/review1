include /etc/ldap/schema/core.schema
include /etc/ldap/schema/cosine.schema
include /etc/ldap/schema/inetorgperson.schema

pidfile /app/ldap/runtime/consumer.pid
argsfile /app/ldap/runtime/consumer.args

modulepath /usr/lib/ldap
moduleload back_mdb
moduleload syncprov

serverID @SERVER_ID@ ldap://127.0.0.1:2389

authz-regexp "gidNumber=0\\\+uidNumber=0,cn=peercred,cn=external,cn=auth"
  "cn=admin,dc=example,dc=com"

database mdb
maxsize 1073741824
suffix "dc=example,dc=com"
rootdn "cn=admin,dc=example,dc=com"
rootpw adminsecret
directory /app/ldap/consumer/data
index objectClass eq
index entryUUID eq
index contextCSN eq
index cn,uid eq
index member eq

include /app/config/consumer/acl.conf

overlay syncprov
syncprov-checkpoint 100 10

syncrepl rid=101
  provider=ldap://127.0.0.1:1389
  bindmethod=simple
  binddn="cn=replicator,dc=example,dc=com"
  credentials=replicsecret
  searchbase="dc=example,dc=com"
  scope=sub
  schemachecking=off
  type=refreshAndPersist
  retry="60 +"

database mdb
maxsize 268435456
suffix "dc=verifier,dc=internal"
rootdn "cn=admin,dc=verifier,dc=internal"
rootpw adminsecret
directory /app/ldap/consumer/verifier-data
include /app/config/consumer/acl.conf
index objectClass eq
index entryUUID eq
index contextCSN eq

overlay syncprov
syncprov-checkpoint 100 10

syncrepl rid=102
  provider=ldap://127.0.0.1:1389
  bindmethod=simple
  binddn="cn=replicator,dc=example,dc=com"
  credentials=replicsecret
  searchbase="dc=verifier,dc=internal"
  scope=sub
  schemachecking=off
  type=refreshAndPersist
  retry="60 +"
