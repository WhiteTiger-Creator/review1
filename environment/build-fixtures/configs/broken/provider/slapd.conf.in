include /etc/ldap/schema/core.schema
include /etc/ldap/schema/cosine.schema
include /etc/ldap/schema/inetorgperson.schema

pidfile /app/ldap/runtime/provider.pid
argsfile /app/ldap/runtime/provider.args

modulepath /usr/lib/ldap
moduleload back_mdb
moduleload syncprov
moduleload accesslog

serverID @SERVER_ID@ ldap://127.0.0.1:1389

authz-regexp "gidNumber=0\\\+uidNumber=0,cn=peercred,cn=external,cn=auth"
  "cn=admin,dc=example,dc=com"

database mdb
maxsize 536870912
suffix "cn=accesslog"
rootdn "cn=admin,cn=accesslog"
rootpw adminsecret
directory /app/ldap/provider/accesslog
include /app/config/provider/acl.conf
index objectClass eq
index entryCSN eq
index reqStart eq
index entryUUID eq

database mdb
maxsize 1073741824
suffix "dc=example,dc=com"
rootdn "cn=admin,dc=example,dc=com"
rootpw adminsecret
directory /app/ldap/provider/data
index objectClass eq
index entryUUID eq
index contextCSN eq
index cn,uid eq
index member eq

include /app/config/provider/acl.conf

overlay syncprov
syncprov-checkpoint 100 10
syncprov-nopresent TRUE

overlay accesslog
logops writes
logsuccess TRUE
logpurge 00+01:00:00 00+00:15:00
logdb cn=accesslog

database mdb
maxsize 268435456
suffix "dc=verifier,dc=internal"
directory /app/ldap/provider/verifier-data
include /app/config/provider/acl.conf
index objectClass eq
index entryUUID eq
index contextCSN eq

overlay syncprov
syncprov-checkpoint 100 10
