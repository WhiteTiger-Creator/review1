[Unit]
Description=Memcg peak lane unit for cgroup slice %i
After=local-fs.target
Documentation=file:///app/environment/docs/operators.md

[Service]
Type=oneshot
# Lane-scoped memcg peak drive; MemoryAccounting mirrors host cgroup accounting.
MemoryAccounting=yes
ExecStart=/app/bin/hwm_drive --root /app/environment --out /app/output/peak_report.json
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
