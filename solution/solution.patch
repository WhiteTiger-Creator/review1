 func Extract(tile Tile) (Features, error) {
-	_ = tile
-	return Features{}, fmt.Errorf("feature extraction is not implemented")
+	if tile.Width != tile.Height || tile.Width < 16 || len(tile.Pixels) != tile.Width*tile.Height {
+		return Features{}, fmt.Errorf("invalid square ROI")
+	}
+	n := tile.Width
+	sum := 0.0
+	for _, value := range tile.Pixels {
+		if math.IsNaN(value) || math.IsInf(value, 0) {
+			return Features{}, fmt.Errorf("non-finite pixel")
+		}
+		sum += value
+	}
+	meanRaw := sum / float64(len(tile.Pixels))
+	variance := 0.0
+	for _, value := range tile.Pixels {
+		delta := value - meanRaw
+		variance += delta * delta
+	}
+	stdRaw := math.Sqrt(variance / float64(len(tile.Pixels)))
+	u := make([]float64, n)
+	for index := range u {
+		u[index] = 0.5 * (1 - math.Cos(2*math.Pi*float64(index)/float64(n-1)))
+	}
+	windowed := make([]float64, len(tile.Pixels))
+	weightSum := 0.0
+	for y := 0; y < n; y++ {
+		for x := 0; x < n; x++ {
+			weight := u[x] * u[y]
+			windowed[y*n+x] = (tile.Pixels[y*n+x] - meanRaw) * weight
+			weightSum += weight
+		}
+	}
+	if weightSum <= 0 {
+		return Features{}, fmt.Errorf("invalid window")
+	}
+	power, err := fftPower(windowed, n, n)
+	if err != nil {
+		return Features{}, err
+	}
+	norm := weightSum * weightSum
+	for index := range power {
+		power[index] /= norm
+	}
+	bins, err := radial(power, n, n, 6)
+	if err != nil {
+		return Features{}, err
+	}
+	values := make([]float64, 0, 9)
+	values = append(values, meanRaw/255.0, stdRaw/255.0)
+	for _, value := range bins {
+		values = append(values, math.Log1p(value))
+	}
+	low, high := bins[0]+bins[1]+bins[2], bins[3]+bins[4]+bins[5]
+	values = append(values, math.Log1p(high/math.Max(low, 1e-30)))
+	for _, value := range values {
+		if math.IsNaN(value) || math.IsInf(value, 0) {
+			return Features{}, fmt.Errorf("non-finite feature")
+		}
+	}
+	return Features{Values: values}, nil
 }
