+	minFPR, maxFPR := math.Inf(1), math.Inf(-1)
+	for _, site := range sites {
+		items := siteValues[site]
+		cov, tp, positives, fp, negatives := 0, 0, 0, 0, 0
+		for _, item := range items {
+			if item.Abstained {
+				continue
+			}
+			cov++
+			if item.Sample.Label == 1 {
+				positives++
+				if item.Prediction == 1 {
+					tp++
+				}
+			} else {
+				negatives++
+				if item.Prediction == 1 {
+					fp++
+				}
+			}
+		}
+		if positives == 0 || negatives == 0 {
+			return Metrics{}, fmt.Errorf("site lacks covered labels")
+		}
+		fpr := float64(fp) / float64(negatives)
