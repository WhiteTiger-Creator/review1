+		high := float64(bin+1) / float64(campaign.ECEBins)
+		for _, item := range values {
+			in := item.Probability >= low && (item.Probability < high || (bin == campaign.ECEBins-1 && item.Probability <= high))
+			if in {
+				count++
+				probSum += item.Probability
+				labelSum += float64(item.Sample.Label)
+			}
+		}
+		if count > 0 {
+			ece += float64(count) / float64(len(values)) * math.Abs(probSum/float64(count)-labelSum/float64(count))
+		}
+	}
