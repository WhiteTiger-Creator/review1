+#include <math.h>
+#include <stddef.h>
+int orbit_radial_accumulate(const double *power, int width, int height, int spectrum_width, double *sums, uint64_t *counts, int bin_count) {
+    if (power == NULL || sums == NULL || counts == NULL || width < 4 || height < 4 || spectrum_width != width / 2 + 1 || bin_count < 1) return 1;
+    for (int y = 0; y < height; ++y) {
+        const int ky = y <= height / 2 ? y : y - height;
+        for (int x = 0; x < spectrum_width; ++x) {
+            const int bin = (int)floor(hypot((double)x, (double)ky));
+            if (bin >= 1 && bin <= bin_count) {
+                const uint64_t multiplicity = (x == 0 || (width % 2 == 0 && x == width / 2)) ? 1U : 2U;
+                const size_t offset = (size_t)y * (size_t)spectrum_width + (size_t)x;
+                sums[bin - 1] += power[offset] * (double)multiplicity;
+                counts[bin - 1] += multiplicity;
+            }
+        }
+    }
+    return 0;
 }
