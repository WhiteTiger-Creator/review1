+		}
+		for index, value := range item.Features {
+			observed[index] += value
+		}
+		delta := item.Probability - float64(item.Sample.Label)
+		brier += delta * delta
+		siteValues[item.Sample.SiteID] = append(siteValues[item.Sample.SiteID], item)
+		if !item.Abstained {
+			covered++
+			totals[item.Sample.Label]++
