@@ -2,10 +2,53 @@ package model
 
 import (
 	"fmt"
+	"math"
 	"orbit.local/sentinel/internal/catalog"
 )
 
+func sigmoid(value float64) float64 {
+	if value >= 0 {
+		z := math.Exp(-value)
+		return 1 / (1 + z)
+	}
+	z := math.Exp(value)
+	return z / (1 + z)
+}
+
 func Infer(campaign catalog.Campaign, sample catalog.Sample, features []float64, etag string) (Evaluation, error) {
-	_, _, _, _ = campaign, sample, features, etag
-	return Evaluation{}, fmt.Errorf("ensemble inference is not implemented")
+	if len(features) != campaign.FeatureCount {
+		return Evaluation{}, fmt.Errorf("feature count mismatch")
+	}
+	probabilities := make([]float64, len(campaign.Heads))
+	weighted, totalWeight := 0.0, 0.0
+	for index, head := range campaign.Heads {
+		logit := head.Intercept
+		for featureIndex, value := range features {
+			logit += head.Weights[featureIndex] * value
+		}
+		probability := sigmoid(logit / head.Temperature)
+		probabilities[index] = probability
+		weighted += probability * head.VoteWeight
+		totalWeight += head.VoteWeight
+	}
+	if totalWeight <= 0 {
+		return Evaluation{}, fmt.Errorf("invalid vote weight")
+	}
+	probability := weighted / totalWeight
+	minimum, maximum := probabilities[0], probabilities[0]
+	for _, value := range probabilities[1:] {
+		if value < minimum {
+			minimum = value
+		}
+		if value > maximum {
+			maximum = value
+		}
+	}
+	uncertainty := maximum - minimum
+	abstained := uncertainty > campaign.AbstainSpread
+	prediction := 0
+	if probability >= campaign.DecisionThreshold {
+		prediction = 1
+	}
+	return Evaluation{Sample: sample, Features: append([]float64(nil), features...), Probability: probability, Uncertainty: uncertainty, Abstained: abstained, Prediction: prediction, ETag: etag}, nil
 }
