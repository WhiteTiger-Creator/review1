+				correct[item.Sample.Label]++
+			}
+		}
+	}
+	if totals[0] == 0 || totals[1] == 0 {
+		return Metrics{}, fmt.Errorf("covered predictions lack both labels")
+	}
+	coverage := float64(covered) / float64(len(values))
