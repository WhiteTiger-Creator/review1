+func pow97(i int) float64 {
+	r := 1.0
+	for k := 0; k < i; k++ {
+		r *= 0.97
+	}
+	return r
+}
+
+func buildQ(bands []float64) []float64 {
+	out := make([]float64, len(bands))
+	if len(bands) == 0 {
+		return out
+	}
+	out[0] = 0
+	acc := 0.0
+	for i := 1; i < len(bands); i++ {
+		c := costAt(bands, i)
+		term := c * pow97(i)
+		acc += term
+		if acc < 0 {
+			acc = 0
+		}
+		out[i] = acc
+	}
+	return out
+}
+
+func priorLooksStale(bands, prior []float64) bool {
+	if len(prior) != len(bands) || len(prior) == 0 {
+		return true
+	}
+	allZ := true
+	for _, v := range prior {
+		if v != 0 {
+			allZ = false
+			break
+		}
+	}
+	if allZ {
+		return true
+	}
+	fresh := buildQ(bands)
+	for i := range fresh {
+		d := fresh[i] - prior[i]
+		if d < 0 {
+			d = -d
+		}
+		if d > 1e-9 {
+			return true
+		}
+	}
+	return false
+}
