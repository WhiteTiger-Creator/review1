MATCH (s:CandidateSet)-[:SET_OF]->(f:Framework)
WITH s, f,
  COUNT { MATCH (is0:Argument)-[:RAISES]->(io1:Attack)-[:STRIKES]->(it2:Argument)
    WHERE EXISTS { MATCH (is0)-[:MEMBER]->(s) } AND EXISTS { MATCH (it2)-[:MEMBER]->(s) } AND NOT EXISTS { MATCH (io1)<-[:UNDERCUTS]-(uc4:Attack)<-[:RAISES]-(ur3:Argument) WHERE EXISTS { MATCH (ur3)-[:MEMBER]->(s) } AND NOT EXISTS { MATCH (uc4)<-[:UNDERCUTS]-(uc6:Attack)<-[:RAISES]-(ur5:Argument) WHERE EXISTS { MATCH (ur5)-[:MEMBER]->(s) } } } } AS live_internal_attacks,
  COUNT { MATCH (dm7:Argument)-[:MEMBER]->(s)
    WHERE EXISTS { MATCH (da8:Argument)-[:RAISES]->(do9:Attack)-[:STRIKES]->(dm7)
                   WHERE NOT EXISTS { MATCH (do9)<-[:UNDERCUTS]-(uc13:Attack)<-[:RAISES]-(ur12:Argument) WHERE EXISTS { MATCH (ur12)-[:MEMBER]->(s) } AND NOT EXISTS { MATCH (uc13)<-[:UNDERCUTS]-(uc15:Attack)<-[:RAISES]-(ur14:Argument) WHERE EXISTS { MATCH (ur14)-[:MEMBER]->(s) } } } AND NOT EXISTS { MATCH (dd10:Argument)-[:RAISES]->(dc11:Attack)-[:STRIKES]->(da8) WHERE EXISTS { MATCH (dd10)-[:MEMBER]->(s) } AND NOT EXISTS { MATCH (dc11)<-[:UNDERCUTS]-(uc17:Attack)<-[:RAISES]-(ur16:Argument) WHERE EXISTS { MATCH (ur16)-[:MEMBER]->(s) } AND NOT EXISTS { MATCH (uc17)<-[:UNDERCUTS]-(uc19:Attack)<-[:RAISES]-(ur18:Argument) WHERE EXISTS { MATCH (ur18)-[:MEMBER]->(s) } } } } } } AS undefended_members,
  COUNT { MATCH (oa20:Argument)-[:IN_FRAMEWORK]->(f)
    WHERE NOT EXISTS { MATCH (oa20)-[:MEMBER]->(s) }
      AND NOT EXISTS { MATCH (om21:Argument)-[:RAISES]->(oo22:Attack)-[:STRIKES]->(oa20)
                        WHERE EXISTS { MATCH (om21)-[:MEMBER]->(s) } AND NOT EXISTS { MATCH (oo22)<-[:UNDERCUTS]-(uc24:Attack)<-[:RAISES]-(ur23:Argument) WHERE EXISTS { MATCH (ur23)-[:MEMBER]->(s) } AND NOT EXISTS { MATCH (uc24)<-[:UNDERCUTS]-(uc26:Attack)<-[:RAISES]-(ur25:Argument) WHERE EXISTS { MATCH (ur25)-[:MEMBER]->(s) } } } } } AS unattacked_outsiders
WITH s, f, live_internal_attacks, undefended_members, unattacked_outsiders,
  ((live_internal_attacks + 0) = 0 AND (undefended_members + 0) = 0) AS adm,
  ((live_internal_attacks + 0) = 0 AND (unattacked_outsiders + 0) = 0) AS stb
OPTIONAL MATCH (t:CandidateSet)-[:SET_OF]->(f)
  WHERE t.id <> s.id
    AND NOT EXISTS { MATCH (sa27:Argument)-[:MEMBER]->(s)
                     WHERE NOT EXISTS { MATCH (sa27)-[:MEMBER]->(t) } }
    AND EXISTS { MATCH (sb28:Argument)-[:MEMBER]->(t)
                 WHERE NOT EXISTS { MATCH (sb28)-[:MEMBER]->(s) } }
    AND NOT EXISTS { MATCH (rs29:Argument)-[:RAISES]->(ro30:Attack)-[:STRIKES]->(rt31:Argument)
                     WHERE EXISTS { MATCH (rs29)-[:MEMBER]->(t) } AND EXISTS { MATCH (rt31)-[:MEMBER]->(t) } AND NOT EXISTS { MATCH (ro30)<-[:UNDERCUTS]-(uc33:Attack)<-[:RAISES]-(ur32:Argument) WHERE EXISTS { MATCH (ur32)-[:MEMBER]->(t) } AND NOT EXISTS { MATCH (uc33)<-[:UNDERCUTS]-(uc35:Attack)<-[:RAISES]-(ur34:Argument) WHERE EXISTS { MATCH (ur34)-[:MEMBER]->(t) } } } }
    AND NOT EXISTS { MATCH (dm36:Argument)-[:MEMBER]->(t)
    WHERE EXISTS { MATCH (da37:Argument)-[:RAISES]->(do38:Attack)-[:STRIKES]->(dm36)
                   WHERE NOT EXISTS { MATCH (do38)<-[:UNDERCUTS]-(uc42:Attack)<-[:RAISES]-(ur41:Argument) WHERE EXISTS { MATCH (ur41)-[:MEMBER]->(t) } AND NOT EXISTS { MATCH (uc42)<-[:UNDERCUTS]-(uc44:Attack)<-[:RAISES]-(ur43:Argument) WHERE EXISTS { MATCH (ur43)-[:MEMBER]->(t) } } } AND NOT EXISTS { MATCH (dd39:Argument)-[:RAISES]->(dc40:Attack)-[:STRIKES]->(da37) WHERE EXISTS { MATCH (dd39)-[:MEMBER]->(t) } AND NOT EXISTS { MATCH (dc40)<-[:UNDERCUTS]-(uc46:Attack)<-[:RAISES]-(ur45:Argument) WHERE EXISTS { MATCH (ur45)-[:MEMBER]->(t) } AND NOT EXISTS { MATCH (uc46)<-[:UNDERCUTS]-(uc48:Attack)<-[:RAISES]-(ur47:Argument) WHERE EXISTS { MATCH (ur47)-[:MEMBER]->(t) } } } } } }
WITH s, live_internal_attacks, undefended_members, unattacked_outsiders, adm, stb,
     count(t) AS n_super
RETURN s.name AS candidate_set,
       live_internal_attacks AS live_internal_attacks,
       undefended_members AS undefended_members,
       unattacked_outsiders AS unattacked_outsiders,
       adm AS admissible,
       stb AS stable,
       (adm AND (n_super + 0) = 0) AS maximal_admissible
