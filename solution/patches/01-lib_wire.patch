+
+function(span_forbid_tool_edge tgt)
+  get_target_property(_libs ${tgt} INTERFACE_LINK_LIBRARIES)
+  if(_libs)
+    foreach(_lib IN LISTS _libs)
+      if(_lib MATCHES "crc_probe" OR _lib MATCHES "mtime_hint")
+        message(FATAL_ERROR "tooling helper ${_lib} must not ride ${tgt} INTERFACE")
+      endif()
+    endforeach()
+  endif()
+endfunction()
