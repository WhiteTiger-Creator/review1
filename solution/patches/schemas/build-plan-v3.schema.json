{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aurora-build-plan-v3.schema.json",
  "type": "object",
  "required": ["format", "generator", "lock_fingerprint", "jobs"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "aurora-build-plan-v3" },
    "generator": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "lock_fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "jobs": {
      "type": "array",
      "items": { "$ref": "#/$defs/job" }
    }
  },
  "$defs": {
    "filter": {
      "type": "object",
      "required": ["phase", "sequence", "name", "args"],
      "additionalProperties": false,
      "properties": {
        "phase": { "type": "integer" },
        "sequence": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" },
        "args": { "type": "string" }
      }
    },
    "job": {
      "type": "object",
      "required": ["job_id", "asset_id", "profile", "artifact_name", "cache_key", "output", "filters"],
      "additionalProperties": false,
      "properties": {
        "job_id": { "type": "string" },
        "asset_id": { "type": "string" },
        "profile": { "type": "string" },
        "artifact_name": { "type": "string" },
        "cache_key": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "output": { "type": "object" },
        "filters": { "type": "array", "items": { "$ref": "#/$defs/filter" } },
        "subtitle_artifacts": { "type": "array" }
      }
    }
  }
}