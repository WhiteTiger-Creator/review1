+func locateReactiveEvents(
+	buses []grid.Bus,
+	lay *equations.Layout,
+	y map[[2]string]complex128,
+	demands map[string]deck.Demand,
+	zPrev, tPrev, zCurr []float64,
+	cands []limits.Candidate,
+	ramp *deck.Ramp,
+	eventIndexStart int,
+) ([]float64, []float64, []limits.EventRow, error) {
+	sort.Slice(cands, func(i, j int) bool { return cands[i].BusID < cands[j].BusID })
+	type hit struct {
+		cand   limits.Candidate
+		lambda float64
+		z      []float64
+	}
+	var hits []hit
+	for _, c := range cands {
+		zh, lh, e := refineReactive(buses, *lay, y, demands, zPrev, zCurr, c, ramp)
+		if e != nil {
+			return nil, nil, nil, e
+		}
+		hits = append(hits, hit{cand: c, lambda: lh, z: zh})
+	}
+	sort.Slice(hits, func(i, j int) bool {
+		if hits[i].lambda != hits[j].lambda {
+			return hits[i].lambda < hits[j].lambda
+		}
+		return hits[i].cand.BusID < hits[j].cand.BusID
+	})
+	proto := make([]limits.EventRow, len(hits))
+	for i, h := range hits {
+		proto[i] = limits.EventRow{Lambda: h.lambda, BusID: h.cand.BusID, Kind: h.cand.Kind, QLimit: h.cand.QLim}
+	}
+	groupMeta := limits.GroupSimultaneous(proto, ramp.FoldTolerance)
+	busSet := map[string]hit{}
+	for _, h := range hits {
+		busSet[h.cand.BusID] = h
+	}
+	var group []hit
+	for _, g := range groupMeta {
+		group = append(group, busSet[g.BusID])
+	}
+	sort.Slice(group, func(i, j int) bool { return group[i].cand.BusID < group[j].cand.BusID })
+
+	zEvent := append([]float64(nil), group[0].z...)
+	x, lam := equations.ZUnpack(zEvent)
+	equations.UnpackState(buses, *lay, x)
+	var rows []limits.EventRow
+	for i, h := range group {
+		limits.ApplySwitch(buses, h.cand.BusID, h.cand.Kind)
+		rows = append(rows, limits.EventRow{
+			Index: eventIndexStart + i, Lambda: lam, BusID: h.cand.BusID,
+			Kind: h.cand.Kind, QLimit: h.cand.QLim, VoltagePU: busVoltage(buses, h.cand.BusID),
+		})
+	}
+	*lay = equations.BuildLayout(buses)
+	xNew := equations.PackState(buses, *lay)
+	zEvent = equations.ZPack(xNew, lam)
+	tEvent, err := ComputeTangent(buses, *lay, y, demands, nil)
+	if err != nil {
+		return nil, nil, nil, err
+	}
+	if tEvent[len(tEvent)-1] < 0 {
+		linear.Scale(tEvent, tEvent, -1)
+	}
+	_ = tPrev
+	return zEvent, tEvent, rows, nil
+}
+
+func refineReactive(
+	buses []grid.Bus,
+	lay equations.Layout,
+	y map[[2]string]complex128,
+	demands map[string]deck.Demand,
+	zPrev, zCurr []float64,
+	c limits.Candidate,
+	ramp *deck.Ramp,
+) ([]float64, float64, error) {
+	lo := append([]float64(nil), zPrev...)
+	hi := append([]float64(nil), zCurr...)
+	var midZ []float64
+	for k := 0; k < 48; k++ {
+		mid := make([]float64, len(lo))
+		for i := range lo {
+			mid[i] = 0.5 * (lo[i] + hi[i])
+		}
+		sec := make([]float64, len(lo))
+		for i := range lo {
+			sec[i] = hi[i] - lo[i]
+		}
+		nrm := linear.VecNorm2(sec)
+		if nrm == 0 {
+			midZ = mid
+			break
+		}
+		linear.Scale(sec, sec, 1/nrm)
+		work := cloneBuses(buses)
+		cr, err := Correct(work, lay, y, demands, mid, sec, ramp)
+		if err != nil || !cr.OK {
+			midZ = mid
+			x, lam := equations.ZUnpack(mid)
+			equations.UnpackState(work, lay, x)
+			qg := qGeneration(work, y, demands, lam, c.BusID)
+			if math.Abs(qg-c.QLim) <= ramp.ReactiveEventTol {
+				equations.UnpackState(buses, lay, x)
+				return mid, lam, nil
+			}
+			if (c.Kind == limits.Upper && qg > c.QLim) || (c.Kind == limits.Lower && qg < c.QLim) {
+				hi = mid
+			} else {
+				lo = mid
+			}
+			continue
+		}
+		midZ = cr.Z
+		x, lam := equations.ZUnpack(midZ)
+		equations.UnpackState(work, lay, x)
+		qg := qGeneration(work, y, demands, lam, c.BusID)
+		if math.Abs(qg-c.QLim) <= ramp.ReactiveEventTol {
+			equations.UnpackState(buses, lay, x)
+			return midZ, lam, nil
+		}
+		if (c.Kind == limits.Upper && qg > c.QLim) || (c.Kind == limits.Lower && qg < c.QLim) {
+			hi = midZ
+		} else {
+			lo = midZ
+		}
+	}
+	if midZ == nil {
+		midZ = hi
+	}
+	x, lam := equations.ZUnpack(midZ)
+	equations.UnpackState(buses, lay, x)
+	return midZ, lam, nil
+}
+
+func qGeneration(buses []grid.Bus, y map[[2]string]complex128, demands map[string]deck.Demand, lam float64, id string) float64 {
+	_, q := equations.Injections(buses, y)
+	for _, b := range buses {
+		if b.ID == id {
+			return equations.PVQGen(b, q[id], demands, lam)
+		}
+	}
+	return 0
+}
+
+func busVoltage(buses []grid.Bus, id string) float64 {
+	for _, b := range buses {
+		if b.ID == id {
+			return b.V
+		}
+	}
+	return 0
+}
+
+func publish(
+	net *deck.Network,
+	ramp *deck.Ramp,
+	buses []grid.Bus,
+	branches []grid.Branch,
+	y map[[2]string]complex128,
+	demands map[string]deck.Demand,
+	curve []record.CurveRow,
+	events []record.EventRow,
+	lam float64,
+	ref fold.RefineResult,
+) (*TraceOutcome, error) {
+	flows := grid.ComputeFlows(buses, branches)
+	var pLoss, qLoss float64
+	brRows := make([]record.BranchRow, len(flows))
+	for i, f := range flows {
+		brRows[i] = record.BranchRow{
+			BranchID: f.BranchID, Status: f.Status, From: f.From, To: f.To,
+			PFrom: f.PFrom, QFrom: f.QFrom, PTo: f.PTo, QTo: f.QTo, PLoss: f.PLoss, QLoss: f.QLoss,
+		}
+		pLoss += f.PLoss
+		qLoss += f.QLoss
+	}
+
+	minV := math.Inf(1)
+	for _, b := range buses {
+		if b.V < minV {
+			minV = b.V
+		}
+	}
+	var limiting []string
+	viol := 0
+	busRows := make([]record.BusRow, len(buses))
+	pInj, qInj := equations.Injections(buses, y)
+	for i, b := range buses {
+		state := "WITHIN"
+		if b.V < ramp.VoltageMin {
+			state = "LOW"
+			viol++
+		} else if b.V > ramp.VoltageMax {
+			state = "HIGH"
+			viol++
+		}
+		if math.Abs(b.V-minV) <= 1e-10 {
+			limiting = append(limiting, b.ID)
+		}
+		dp, dq := 0.0, 0.0
+		if d, ok := demands[b.ID]; ok {
+			dp, dq = d.DeltaP, d.DeltaQ
+		}
+		pload := b.PLoad0 + lam*dp
+		qload := b.QLoad0 + lam*dq
+		pg, qg := b.PGen, b.QGen
+		if b.Type == deck.BusPV && !b.Switched {
+			qg = equations.PVQGen(b, qInj[b.ID], demands, lam)
+		}
+		if b.Type == deck.BusSlack {
+			pg = pInj[b.ID] + pload
+			qg = qInj[b.ID] + qload
+		}
+		busRows[i] = record.BusRow{
+			BusID: b.ID, FinalType: string(b.Type), VoltagePU: b.V, AngleDeg: b.AngleRad * 180 / math.Pi,
+			PGen: pg, QGen: qg, PLoad: pload, QLoad: qload, VoltageState: state,
+		}
+	}
+
+	maxPow := 0.0
+	maxArc := 0.0
+	for _, c := range curve {
+		if c.MaxPowerMismatch > maxPow {
+			maxPow = c.MaxPowerMismatch
+		}
+		if math.Abs(c.ArcResidual) > maxArc {
+			maxArc = math.Abs(c.ArcResidual)
+		}
+	}
