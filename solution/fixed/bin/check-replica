#!/usr/bin/env bash
set -euo pipefail

source /app/lib/common.sh
source /app/lib/compare-trees.sh
source /app/lib/write-status.sh

output="/output/replication-status.json"
recovery_mode="none"

if [[ -f "${LDAP_RUNTIME}/last-recovery-mode" ]]; then
  recovery_mode="$(tr -d '[:space:]' <"${LDAP_RUNTIME}/last-recovery-mode")"
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --report)
      output="$2"
      shift 2
      ;;
    *)
      echo "usage: check-replica [--report PATH]" >&2
      exit 2
      ;;
  esac
done

parent="$(dirname "${output}")"
if [[ -e "${parent}" && ! -d "${parent}" ]]; then
  echo "report parent is not a directory: ${parent}" >&2
  exit 1
fi

if ! wait_for_port "${PROVIDER_URI}" 5 1; then
  echo "provider is not reachable" >&2
  rm -f "${output}"
  exit 1
fi
if ! wait_for_port "${CONSUMER_URI}" 5 1; then
  echo "consumer is not reachable" >&2
  rm -f "${output}"
  exit 1
fi

tmpdir_out="$(mktemp)"
write_replication_status "${tmpdir_out}" "${recovery_mode}"

if trees_equivalent_for_base "${BASE_DN}"; then
  mv -f "${tmpdir_out}" "${output}"
  exit 0
fi

rm -f "${tmpdir_out}"
rm -f "${output}"
exit 1
