+func wipeCache(cache map[int]float64) {
+	for k := range cache {
+		delete(cache, k)
+	}
+}
+
+func refillPrefix(traj []float64, cache map[int]float64, upto int, out []float64) int {
+	prev := -1
+	for e := 0; e <= upto; e++ {
+		b, c := freshBand(traj, e)
+		if e > 0 && prev >= 0 && c != prev {
+			wipeCache(cache)
+			for j := 0; j < e; j++ {
+				bj, _ := freshBand(traj, j)
+				cache[j] = bj
+				out[j] = bj
+			}
+		}
+		cache[e] = b
+		out[e] = b
+		prev = c
+	}
+	return prev
+}
