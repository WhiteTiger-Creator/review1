-int qdrift_topo_layer_index(const qdrift_graph_t *g, const char *id) {
-    return layer_index_by_id(g, id);
+int qdrift_topo_sort(const qdrift_graph_t *g, int *order_out, int max_layers) {
+    int n = g->layer_count < max_layers ? g->layer_count : max_layers;
+    int done[QDRIFT_MAX_LAYERS];
+    int done_n = 0;
+    int out_n = 0;
+    while (out_n < n) {
+        int progressed = 0;
+        for (int i = 0; i < n; ++i) {
+            int used = 0;
+            for (int j = 0; j < out_n; ++j) {
+                if (order_out[j] == i) {
+                    used = 1;
+                    break;
+                }
+            }
+            if (used) {
+                continue;
+            }
+            if (deps_satisfied(g, i, done, done_n)) {
+                order_out[out_n++] = i;
+                done[done_n++] = i;
+                progressed = 1;
+            }
+        }
+        if (!progressed) {
+            return -1;
+        }
+    }
+    return out_n;
 }
