+func mergeNeg(caller, derived []string) []string {
+	merged := map[string]struct{}{}
+	for _, n := range caller {
+		if n != "" {
+			merged[n] = struct{}{}
+		}
+	}
+	for _, n := range derived {
+		merged[n] = struct{}{}
+	}
+	keys := make([]string, 0, len(merged))
+	for k := range merged {
+		keys = append(keys, k)
+	}
+	sort.Slice(keys, func(i, j int) bool {
+		return keys[i] < keys[j]
+	})
+	return keys
+}
+
+func buildGrants(rows []Row) ([]map[string]string, int) {
+	grants := make([]map[string]string, 0, len(rows))
+	seenSid := map[string]struct{}{}
+	fldAny := 0
+	for _, r := range rows {
+		if _, ok := seenSid[r.Sid]; ok {
+			continue
+		}
+		seenSid[r.Sid] = struct{}{}
+		grants = append(grants, map[string]string{"sid": r.Sid, "acc": accOf(r.Cls)})
+		if r.Fld == 1 {
+			fldAny = 1
+		}
+	}
+	sort.Slice(grants, func(i, j int) bool { return grants[i]["sid"] < grants[j]["sid"] })
+	return grants, fldAny
+}
