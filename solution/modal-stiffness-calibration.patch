-pub fn publish_bytes(_report_path: &Path, _bytes: &[u8]) -> AppResult<()> {
-    fail(
-        FailureCode::EReport,
-        "atomic report publication unavailable",
-    )
+pub fn publish_bytes(report_path: &Path, bytes: &[u8]) -> AppResult<()> {
+    let parent = report_path
+        .parent()
+        .filter(|p| !p.as_os_str().is_empty())
+        .unwrap_or_else(|| Path::new("."));
+    fs::create_dir_all(parent).map_err(|e| (FailureCode::EReport, e.to_string()))?;
+    let mut tmp: PathBuf = parent.join(format!(
+        ".{}.mcr.tmp.{}",
+        report_path
+            .file_name()
+            .and_then(|s| s.to_str())
+            .unwrap_or("report"),
+        std::process::id()
+    ));
+    for n in 0..1000 {
+        if !tmp.exists() {
+            break;
+        }
+        tmp = parent.join(format!(
+            ".{}.mcr.tmp.{}.{}",
+            report_path
+                .file_name()
+                .and_then(|s| s.to_str())
+                .unwrap_or("report"),
+            std::process::id(),
+            n
+        ));
+    }
+    let write_result = (|| -> AppResult<()> {
+        let mut f = OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(&tmp)
+            .map_err(|e| (FailureCode::EReport, e.to_string()))?;
+        f.write_all(bytes)
+            .map_err(|e| (FailureCode::EReport, e.to_string()))?;
+        f.flush()
+            .map_err(|e| (FailureCode::EReport, e.to_string()))?;
+        f.sync_all()
+            .map_err(|e| (FailureCode::EReport, e.to_string()))?;
+        drop(f);
+        fs::rename(&tmp, report_path).map_err(|e| (FailureCode::EReport, e.to_string()))?;
+        if let Ok(dir) = File::open(parent) {
+            let _ = dir.sync_all();
+        }
+        Ok(())
+    })();
+    if write_result.is_err() {
+        let _ = fs::remove_file(&tmp);
+    }
+    write_result
 }
 
 pub fn preserve_on_failure(_report_path: &Path) {}
