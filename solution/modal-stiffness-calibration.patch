+pub fn project_gradient(grad: &[f64], theta: &[f64], lower: &[f64], upper: &[f64]) -> Vec<f64> {
+    let mut pg = grad.to_vec();
+    for i in 0..theta.len() {
+        let at_lower = (theta[i] - lower[i]).abs() <= 1e-8 * lower[i].abs().max(1.0);
+        let at_upper = (theta[i] - upper[i]).abs() <= 1e-8 * upper[i].abs().max(1.0);
+        if at_lower && pg[i] > 0.0 {
+            // descent direction is -grad; if grad>0, descent points below lower
+            pg[i] = 0.0;
+        } else if at_upper && pg[i] < 0.0 {
+            pg[i] = 0.0;
+        }
+    }
+    pg
 }
 
