-//! Subspace MAC (starter incomplete).
+//! Subspace Modal Assurance Criterion for equal-size clusters.
 
-pub fn subspace_mac(_measured_cols: &[Vec<f64>], _predicted_cols: &[Vec<f64>]) -> Option<f64> {
-    None
+use crate::linalg::orthogonalize::{frobenius_inner_sq, modified_gram_schmidt};
+
+pub fn subspace_mac(measured_cols: &[Vec<f64>], predicted_cols: &[Vec<f64>]) -> Option<f64> {
+    let k = measured_cols.len();
+    if k == 0 || predicted_cols.len() != k {
+        return None;
+    }
+    let u = modified_gram_schmidt(measured_cols);
+    let v = modified_gram_schmidt(predicted_cols);
+    if u.len() != k || v.len() != k {
+        return None;
+    }
+    let mut mac = frobenius_inner_sq(&u, &v) / k as f64;
+    if mac < 0.0 {
+        mac = 0.0;
+    }
+    if mac > 1.0 {
+        mac = 1.0;
+    }
+    Some(mac)
 }
