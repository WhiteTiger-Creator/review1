-    0.0
+pub fn regularization_term(model: &BridgeModel, theta: &[f64], plan: &CalibrationPlan) -> f64 {
+    let mut s = 0.0;
+    for (g, &t) in model.groups.iter().zip(theta.iter()) {
+        let width = g.upper - g.lower;
+        let scaled = (t - g.reference) / width;
+        s += scaled * scaled;
+    }
+    plan.regularization_weight * s
 }
