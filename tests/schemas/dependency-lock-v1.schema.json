{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aurora-dependency-lock-v1.schema.json",
  "type": "object",
  "required": ["format", "fingerprint", "executable", "binary_digest", "version", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "aurora-dependency-lock-v1" },
    "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "executable": { "type": "string" },
    "binary_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "version": { "type": "string" },
    "capabilities": {
      "type": "object",
      "required": ["encoders", "filters", "muxers"],
      "additionalProperties": false,
      "properties": {
        "encoders": { "type": "array", "items": { "type": "string" } },
        "filters": { "type": "array", "items": { "type": "string" } },
        "muxers": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}